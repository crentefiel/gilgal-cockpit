{
  "name": "gilgal-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "verify:gilgal": "node scripts/verify-gilgal.mjs",
    "sentinel:build": "npm --prefix .gilgal/reference/sentinel run build",
    "sentinel": "node .gilgal/reference/sentinel/dist/src/cli.js sentinel --config gilgal.sentinel.json",
    "gilgal": "node .gilgal/reference/sentinel/dist/src/cli.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
